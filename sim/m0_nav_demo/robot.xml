<?xml version="1.0" encoding="utf-8"?>
<mujoco model="lcr_diffdrive">
  <compiler angle="radian" />
  <option timestep="0.01" gravity="0 0 -9.81" iterations="20" />

  <asset>
    <texture type="skybox" builtin="gradient" width="128" height="128" rgb1="0.9 0.95 1" rgb2="0.4 0.55 0.75" />
    <texture type="2d" name="floor" builtin="checker" width="256" height="256" rgb1="0.75 0.78 0.82" rgb2="0.55 0.58 0.62" mark="none" />
    <material name="floor" texture="floor" />
    <material name="body" rgba="0.92 0.32 0.22 1" />
    <material name="wheel" rgba="0.12 0.12 0.12 1" />
    <material name="goal" rgba="0.15 0.85 0.35 1" />
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 4" dir="0 0 -1" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" />
    <geom name="floor" type="plane" size="4 4 0.1" material="floor" />

    <!-- robot: box body + front caster ball + two rear drive wheels (diff drive) -->
    <body name="robot" pos="0 0 0.095">
      <freejoint/>
      <inertial pos="0 0 0" mass="2.0" diaginertia="0.010 0.016 0.008" />
      <geom name="body" type="box" size="0.12 0.10 0.045" material="body" mass="2.0" />
      <body name="caster" pos="0.10 0 -0.06">
        <joint name="caster_joint" type="ball" armature="0.002" damping="0.8" />
        <geom name="caster" type="sphere" size="0.035" material="wheel" />
      </body>
      <body name="wheel_l" pos="0 0.11 -0.05">
        <joint name="wheel_l_joint" type="hinge" axis="0 1 0" armature="0.010" damping="0.020" />
        <geom name="wheel_l" type="cylinder" size="0.05 0.026" material="wheel" />
      </body>
      <body name="wheel_r" pos="0 -0.11 -0.05">
        <joint name="wheel_r_joint" type="hinge" axis="0 1 0" armature="0.010" damping="0.020" />
        <geom name="wheel_r" type="cylinder" size="0.05 0.026" material="wheel" />
      </body>
    </body>

    <body name="goal" pos="1.0 0 0.012">
      <freejoint/>
      <geom name="goal" type="cylinder" size="0.06 0.008" material="goal" mass="6.0" friction="9.9 0.05 0.001" contype="1" conaffinity="1" />
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_l" joint="wheel_l_joint" gear="1.6" ctrlrange="-1 1" forcerange="-1 1" />
    <motor name="motor_r" joint="wheel_r_joint" gear="1.6" ctrlrange="-1 1" forcerange="-1 1" />
  </actuator>
</mujoco>
